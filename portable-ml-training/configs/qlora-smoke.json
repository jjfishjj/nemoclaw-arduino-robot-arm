{
  "run_name": "qwen-qlora-portable-smoke",
  "model": {
    "name_or_path": "Qwen/Qwen2.5-0.5B-Instruct",
    "trust_remote_code": false,
    "max_seq_length": 512
  },
  "dataset": {
    "name": "yahma/alpaca-cleaned",
    "subset": null,
    "train_split": "train",
    "eval_split": null,
    "validation_ratio": 0.02,
    "text_field": null,
    "prompt_field": "instruction",
    "response_field": "output",
    "max_train_samples": 200,
    "max_eval_samples": 20
  },
  "method": {
    "type": "qlora",
    "load_in_4bit": true,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": "all-linear"
  },
  "training": {
    "epochs": 1,
    "max_steps": 20,
    "learning_rate": 0.0002,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "gradient_checkpointing": true,
    "logging_steps": 1,
    "save_steps": 5,
    "eval_steps": 5,
    "save_total_limit": 3,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0,
    "seed": 42,
    "bf16": "auto",
    "tf32": true,
    "optim": "paged_adamw_8bit",
    "report_to": []
  },
  "output": {
    "directory": "outputs/qwen-qlora-portable-smoke",
    "push_to_hub": false,
    "hub_model_id": null,
    "hub_private_repo": true,
    "hub_strategy": "checkpoint"
  },
  "resume": {
    "mode": "auto",
    "allow_hub_checkpoint": true,
    "hub_checkpoint_subdir": "last-checkpoint"
  }
}
