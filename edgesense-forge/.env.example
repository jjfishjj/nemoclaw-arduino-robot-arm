MQTT_HOST=127.0.0.1
MQTT_PORT=1883
DATABASE_PATH=data/edgesense.db
RETENTION_DAYS=30
DEPLOY_DOMAIN=edgesense.example.com
ACME_EMAIL=ops@example.com
EDGE_BIND_ADDRESS=127.0.0.1
# Production: prefer DATABASE_URL_FILE and API_KEY_FILE instead of inline secrets.
# DATABASE_URL_FILE=/run/secrets/database_url
# API_KEY_FILE=/run/secrets/api_key
# MQTT_CA_CERT=/run/secrets/mqtt_ca
# MQTT_CLIENT_CERT=/run/secrets/mqtt_client_cert
# MQTT_CLIENT_KEY=/run/secrets/mqtt_client_key
