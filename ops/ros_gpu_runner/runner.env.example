# Copy values from GitHub: Settings > Actions > Runners > New self-hosted runner.
# Never commit the populated file; registration tokens expire quickly.
GITHUB_URL=https://github.com/OWNER/REPOSITORY
RUNNER_TOKEN=REPLACE_WITH_SHORT_LIVED_TOKEN
RUNNER_VERSION=REPLACE_WITH_VERSION_FROM_GITHUB
RUNNER_SHA256=REPLACE_WITH_LINUX_X64_SHA256_FROM_GITHUB

RUNNER_NAME=rover-gpu-01
RUNNER_LABELS=ros2-jazzy,gpu,gazebo
# RUNNER_GROUP=trusted-robotics
# RUNNER_ROOT=/home/gha-runner/actions-runner
# EPHEMERAL_RUNNER=1
