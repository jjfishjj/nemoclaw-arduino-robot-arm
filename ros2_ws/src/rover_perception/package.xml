<?xml version="1.0"?>
<package format="3">
  <name>rover_perception</name>
  <version>0.1.0</version>
  <description>LiDAR obstacle detection and simulation contract tests for Rover Forge.</description>
  <maintainer email="maintainer@example.com">Rover Forge Maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
