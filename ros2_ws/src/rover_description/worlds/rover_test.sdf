<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rover_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.80</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.12 0.14 0.13 1</ambient><diffuse>0.18 0.22 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="calibration_lane">
      <static>true</static><pose>2.0 0 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 1.0 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.45</mu><mu2>0.40</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>3.0 1.0 0.05</size></box></geometry>
          <material><ambient>0.13 0.18 0.24 1</ambient><diffuse>0.18 0.30 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="collision_box">
      <static>true</static><pose>3.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.8 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.8 0.5</size></box></geometry>
          <material><ambient>0.7 0.2 0.08 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A narrow panel 0.80 m in front of the initial lidar pose. It is the
         deterministic target for the occlusion / obstacle smoke test. -->
    <model name="occlusion_panel">
      <static>true</static><pose>0.90 0 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 0.70 0.60</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 0.70 0.60</size></box></geometry>
          <material><ambient>0.65 0.65 0.10 1</ambient><diffuse>0.90 0.85 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Asymmetric room landmarks make scan matching and loop closure observable. -->
    <model name="north_wall"><static>true</static><pose>0 3.0 0.50 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -3.0 0.50 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>3.0 0 0.50 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-3.0 0 0.50 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></visual></link></model>
    <model name="landmark_column"><static>true</static><pose>-1.4 1.1 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry><material><ambient>0.4 0.1 0.7 1</ambient><diffuse>0.6 0.2 0.9 1</diffuse></material></visual></link></model>
  </world>
</sdf>
