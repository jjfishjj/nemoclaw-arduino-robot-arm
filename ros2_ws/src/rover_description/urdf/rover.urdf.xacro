<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="left_wheel_radius" default="0.075"/>
  <xacro:arg name="right_wheel_radius" default="0.075"/>
  <xacro:property name="base_length" value="0.42"/>
  <xacro:property name="base_width" value="0.32"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.30"/>

  <material name="forge_green"><color rgba="0.30 0.75 0.30 1"/></material>
  <material name="wheel_black"><color rgba="0.04 0.05 0.05 1"/></material>
  <material name="lidar_blue"><color rgba="0.08 0.45 0.85 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <link name="base_link">
    <visual><origin xyz="0 0 ${base_height / 2}"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry><material name="forge_green"/></visual>
    <collision name="base_collision"><origin xyz="0 0 ${base_height / 2}"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${base_height / 2}"/><mass value="8.0"/><inertia ixx="0.0789" ixy="0" ixz="0" iyy="0.1276" iyz="0" izz="0.1750"/></inertial>
  </link>

  <xacro:macro name="wheel" params="prefix y radius">
    <link name="${prefix}_wheel_link">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${radius}" length="${wheel_width}"/></geometry><material name="wheel_black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="0.45"/><inertia ixx="0.00139" ixy="0" ixz="0" iyy="0.00253" iyz="0" izz="0.00139"/></inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel prefix="left" y="${wheel_separation / 2}" radius="$(arg left_wheel_radius)"/>
  <xacro:wheel prefix="right" y="${-wheel_separation / 2}" radius="$(arg right_wheel_radius)"/>

  <link name="caster_link">
    <visual><geometry><sphere radius="0.025"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000025"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="-0.16 0 -0.05"/></joint>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.045" length="0.035"/></geometry><material name="lidar_blue"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.035"/></geometry></collision>
    <inertial><mass value="0.18"/><inertia ixx="0.000068" ixy="0" ixz="0" iyy="0.000068" iyz="0" izz="0.000182"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0.10 0 0.205"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.05 0.07 0.04"/></geometry><material name="lidar_blue"/></visual>
    <inertial><mass value="0.08"/><inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/><origin xyz="0.20 0 0.18"/>
  </joint>

  <ros2_control name="RoverDriveSystem" type="system">
    <hardware>
      <xacro:if value="$(arg use_gazebo)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_gazebo)">
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
      </xacro:unless>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo contact parameters. Nonzero slip plus intentionally biased wheel
       radii in gazebo_rover.launch.py create a repeatable odometry calibration case. -->
  <gazebo reference="left_wheel_link"><mu1>0.95</mu1><mu2>0.95</mu2><slip1>0.02</slip1><slip2>0.02</slip2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>0.90</mu1><mu2>0.90</mu2><slip1>0.025</slip1><slip2>0.025</slip2></gazebo>
  <gazebo reference="caster_link"><mu1>0.08</mu1><mu2>0.08</mu2></gazebo>
  <xacro:if value="$(arg use_gazebo)">
    <gazebo reference="lidar_link">
      <sensor name="front_lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples><resolution>1</resolution>
              <min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.012</stddev></noise>
        </ray>
      </sensor>
    </gazebo>
    <gazebo reference="camera_link">
      <sensor name="front_camera" type="camera">
        <topic>/camera/image_raw</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>20.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
    <gazebo reference="base_link">
      <sensor name="base_contact" type="contact">
        <topic>/bumper/contacts</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <contact><collision>base_collision</collision></contact>
      </sensor>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg use_gazebo)">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find rover_bringup)/config/gazebo_controllers.yaml</parameters>
        <hold_joints>true</hold_joints>
        <ros>
          <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel_safe</remapping>
        </ros>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
